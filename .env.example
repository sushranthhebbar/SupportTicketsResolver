# Copy this file to .env and fill in your own values.
# Add .env to .gitignore before you put a real key in it.

# Default provider configuration for the evaluation run. Keep .env private.
MODEL_API_KEY=your_groq_api_key
MODEL_API_URL=https://api.groq.com/openai/v1/chat/completions
MODEL_NAME=qwen/qwen3.8-27b
EMBEDDING_MODEL=all-MiniLM-L6-v2

CHROMA_PATH=./storage/chroma
DATABASE_URL=sqlite:///./storage/decisions.db
AGENT_API_TOKEN=set_a_long_random_agent_token

LOG_LEVEL=INFO
CONFIDENCE_THRESHOLD=0.80
RETRIEVAL_TOP_K=5
